# Copy to backend/.env and fill in real values. All keys are optional in
# development — settings.py falls back to the defaults shown here — but the
# Saxo integration will not work until SAXO_* are set to real credentials.

# --- Django core ---
# Generate a fresh one for any non-local use:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
# Comma-separated. Leave empty when DEBUG=True; required when DEBUG=False.
ALLOWED_HOSTS=

# --- CORS / frontend ---
# Comma-separated list of allowed browser origins for the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base URL the backend redirects back to after the Saxo OAuth callback.
FRONTEND_URL=http://localhost:5173

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Saxo OpenAPI ---
# "sim" (default) or "live" — selects which Saxo host the client talks to.
SAXO_ENVIRONMENT=sim
SAXO_KEY=
SAXO_SECRET=
SAXO_REDIRECT_URI=http://localhost:8000/api/saxo/callback/
# Fernet key used to encrypt stored Saxo access/refresh tokens. Reading or
# writing a SaxoCredential will crash until this is a real key. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAXO_TOKEN_ENCRYPTION_KEY=
