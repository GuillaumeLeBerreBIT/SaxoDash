# Production settings for the homelab. Copy to /srv/saxodash/.env on the server,
# fill in every blank, then: sudo chown root:root /srv/saxodash/.env && sudo chmod 600 /srv/saxodash/.env
# Never commit the filled-in copy. Generate random values with:
#   openssl rand -hex 32

# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=saxodash.uniroo.dev
CSRF_TRUSTED_ORIGINS=https://saxodash.uniroo.dev
CORS_ALLOWED_ORIGINS=https://saxodash.uniroo.dev
FRONTEND_URL=https://saxodash.uniroo.dev
REPORTING_CURRENCY=EUR

# --- Database ---
# Letters and digits only (openssl rand -hex 32): it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
DB_BACKUP_RETAIN=14
DB_BACKUP_MONTHLY=6

# --- Saxo OpenAPI (LIVE) ---
SAXO_ENVIRONMENT=live
SAXO_KEY=
SAXO_SECRET=
SAXO_REDIRECT_URI=https://saxodash.uniroo.dev/api/saxo/callback/
# The Mac's key keeps copied Saxo tokens readable; a new one means reconnecting Saxo.
SAXO_TOKEN_ENCRYPTION_KEY=

# --- Finnhub, SEC EDGAR, OpenFIGI ---
FINNHUB_API_KEY=
SEC_USER_AGENT=
OPENFIGI_API_KEY=

# --- Enable Banking ---
ENABLE_BANKING_APPLICATION_ID=
# The .pem contents in double quotes, line breaks kept.
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_REDIRECT_URI=https://saxodash.uniroo.dev/api/enablebanking/callback/
