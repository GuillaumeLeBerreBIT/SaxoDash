[Unit]
Description=Deploy SaxoDash when main has a new commit that passed CI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=saxodash-deploy
Group=saxodash-deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/saxodash
ExecStart=/opt/saxodash/deploy/poll.sh
TimeoutStartSec=45min
