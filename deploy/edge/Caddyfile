{
	email {$ACME_EMAIL}
}

*.uniroo.dev {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}

	encode zstd gzip

	@saxodash host saxodash.uniroo.dev
	handle @saxodash {
		reverse_proxy saxodash:80
	}

	@music host music.uniroo.dev
	handle @music {
		reverse_proxy host.docker.internal:{$NAVIDROME_PORT:4533}
	}

	@casa host casa.uniroo.dev
	handle @casa {
		reverse_proxy host.docker.internal:{$CASAOS_PORT:8080}
	}

	handle {
		abort
	}
}
