VITE_API_BASE_URL=http://localhost:8000

# Only needed locally to test the Enable Banking connect flow: it requires
# an HTTPS redirect URL, which plain localhost can't offer. Point this at a
# tunnel (e.g. `ngrok http --url=https://<your-domain> 8000`) matching
# ENABLE_BANKING_REDIRECT_URI in backend/.env - every other request still
# goes to VITE_API_BASE_URL as normal. Leave unset otherwise.
VITE_ENABLE_BANKING_CONNECT_BASE_URL=
